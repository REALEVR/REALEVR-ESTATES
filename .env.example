# Dropbox Configuration
DROPBOX_CLIENT_ID=wifh2kcy9zxidec
DROPBOX_CLIENT_SECRET=mkm08rg0k06ohja
DROPBOX_ACCESS_TOKEN=your_access_token_here

# Database Configuration
DATABASE_URL=your_database_url_here

# AWS Configuration (for S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_aws_region
AWS_S3_BUCKET_NAME=your_s3_bucket

# Flutterwave Configuration
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key

# Gemini AI Configuration (powers the AI Assistant widget and AI-generated
# listing descriptions in the property manager). Both features degrade
# gracefully with a clear error message when this is unset.
GEMINI_API_KEY=your_gemini_api_key_here

# Daily social media posting agent (server/social/*). Generates a per-platform
# caption from a Gemini call and posts once a day via each platform's official API.
# Every var below is a token/ID from that platform's own developer console - NEVER
# a personal username/password. Any platform left unconfigured is skipped
# automatically (status "skipped" in the post results, nothing fails).
# WhatsApp Status is intentionally not supported: Meta exposes no public API for it.

# Facebook Page + Instagram Business account (developers.facebook.com):
# create an app, connect your Page, generate a long-lived Page Access Token.
# The same token is reused for Instagram since IG is accessed through its linked Page.
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# X / Twitter (developer.twitter.com): create a Project + App with Read and Write
# permissions, generate Consumer Keys and Access Token & Secret. Posting requires
# at least the paid Basic API tier as of 2023+.
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# LinkedIn (developer.linkedin.com): create an app, request Marketing Developer
# Platform access for organization posting, generate an OAuth 2.0 access token
# with the w_organization_social scope.
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_ORGANIZATION_URN=urn:li:organization:your_org_id

# Cron expression (UTC) for the daily post. Default: noon UTC.
SOCIAL_POST_CRON=0 12 * * *

# Session Secret
SESSION_SECRET=your_session_secret_here

# Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@realevr.com

# Application Configuration
# Public origin of the site (no trailing slash). Used for auth links, sitemap.xml <loc>, and robots.txt Sitemap line.
BASE_URL=http://localhost:5000
# Same canonical origin for the Vite client (meta tags, canonical URLs, JSON-LD). Must match BASE_URL in production.
VITE_PUBLIC_SITE_URL=http://localhost:5000
NODE_ENV=development
