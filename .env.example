# Dropbox Configuration (real values live in Railway only — this file
# documents which variable names are needed, never carries live credentials)
DROPBOX_CLIENT_ID=your_dropbox_client_id
DROPBOX_CLIENT_SECRET=your_dropbox_client_secret
DROPBOX_ACCESS_TOKEN=your_access_token_here

# Database Configuration
DATABASE_URL=your_database_url_here

# AWS Configuration (for S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_aws_region
AWS_S3_BUCKET_NAME=your_s3_bucket

# Flutterwave Configuration
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key

# IoTec (Uganda mobile money) - gates every rental/BnB virtual-tour view
# (TourPaymentModal.tsx charges 15,000 UGX to unlock a tour for those two
# categories specifically; for_sale/bank_sales properties aren't gated).
# Without all three set, POST /api/payment/iotec/token 503s and a visitor
# trying to view a rental/BnB tour sees "Payment Error" and the tour never
# opens - not a bug in the modal, a missing credential.
IOTEC_CLIENT_ID=your_iotec_client_id
IOTEC_CLIENT_SECRET=your_iotec_client_secret
IOTEC_WALLET_ID=your_iotec_wallet_id

# Conversational AI (GENE) - powers every chat surface: the public floating
# "RealEVR Assistant" widget, the signed-in "My Agent" chat tab, and the
# WhatsApp concierge (server/gene/ai-provider.ts). Tries Claude first, then
# ChatGPT, then Gemini - each of the three below is independently optional;
# set as many as you have. With none set, every surface still replies with a
# clear, still-useful canned/templated response instead of an error.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Also powers AI-generated listing descriptions in the property manager
# (the one feature that's Gemini-only, no Claude/ChatGPT fallback there).
GEMINI_API_KEY=your_gemini_api_key_here

# Daily social media posting agent (server/social/*). Generates a per-platform
# caption from a Gemini call and posts once a day via each platform's official API.
# Every var below is a token/ID from that platform's own developer console - NEVER
# a personal username/password. Any platform left unconfigured is skipped
# automatically (status "skipped" in the post results, nothing fails).
# WhatsApp Status is intentionally not supported: Meta exposes no public API for it.

# Facebook Page + Instagram Business account (developers.facebook.com):
# create an app, connect your Page, generate a long-lived Page Access Token.
# The same token is reused for Instagram since IG is accessed through its linked Page.
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# X / Twitter (developer.twitter.com): create a Project + App with Read and Write
# permissions, generate Consumer Keys and Access Token & Secret. Posting requires
# at least the paid Basic API tier as of 2023+.
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# LinkedIn (developer.linkedin.com): create an app, request Marketing Developer
# Platform access for organization posting, generate an OAuth 2.0 access token
# with the w_organization_social scope.
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_ORGANIZATION_URN=urn:li:organization:your_org_id

# Cron expression (UTC) for the daily post. Default: noon UTC.
SOCIAL_POST_CRON=0 12 * * *

# WhatsApp concierge + agent listing-upload (server/gene/whatsapp*.ts) — the
# public WhatsApp Business number that answers property questions and lets
# a linked agent text "list property" to submit a new listing. Two ways to
# actually send/receive are supported, tried in this order (see whatsapp.ts's
# doc comment) — set the one you're actually using; the other is safe to
# leave blank:
#
# 1. Infobip — a WhatsApp Business Solution Provider with its own onboarding
#    (an Infobip account + a WhatsApp sender they provision), instead of
#    going through Meta Business Manager directly. Get INFOBIP_API_KEY from
#    Developer Tools > API Keys in the Infobip portal; INFOBIP_BASE_URL is
#    the per-account domain shown on that same page (e.g.
#    "xxxxx.api.infobip.com", no "https://"); INFOBIP_WHATSAPP_SENDER is the
#    WhatsApp-enabled number Infobip provisions for you under Channels and
#    Numbers > WhatsApp. Point that sender's inbound webhook at
#    <your-domain>/api/gene/whatsapp/webhook/infobip.
INFOBIP_API_KEY=your_infobip_api_key
INFOBIP_BASE_URL=your_subdomain.api.infobip.com
INFOBIP_WHATSAPP_SENDER=your_infobip_whatsapp_sender_number
#
# 2. Meta WhatsApp Cloud API directly (developers.facebook.com): create an
#    app, add the WhatsApp product, generate a token and note the phone
#    number ID. WHATSAPP_VERIFY_TOKEN is a string you invent yourself and
#    enter in Meta's webhook config — it just has to match on both sides.
#    Point the webhook at <your-domain>/api/gene/whatsapp/webhook.
WHATSAPP_BUSINESS_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=any_string_you_invent
#
# Either way, this is the human-dialable WhatsApp number shown/QR-coded on
# the site (server/gene/whatsapp-growth.ts) — set it to whichever number
# the provider above actually sends from.
WHATSAPP_DISPLAY_NUMBER=+256700000000

# Session Secret
SESSION_SECRET=your_session_secret_here

# Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@realevr.com

# Application Configuration
# Public origin of the site (no trailing slash). Used for auth links, sitemap.xml <loc>, and robots.txt Sitemap line.
BASE_URL=http://localhost:5000
# Same canonical origin for the Vite client (meta tags, canonical URLs, JSON-LD). Must match BASE_URL in production.
VITE_PUBLIC_SITE_URL=http://localhost:5000
NODE_ENV=development
